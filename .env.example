# =====================================================
# KONFIGURASI DATABASE
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linkpendek_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# =====================================================
# KONFIGURASI APLIKASI
# =====================================================
APP_NAME=LinkPendek
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=true
APP_SECRET=change-this-to-random-string-at-least-32-chars

# =====================================================
# DOMAIN SHORT LINK
# =====================================================
SHORT_DOMAIN=lnk.pd

# =====================================================
# JWT CONFIGURATION
# =====================================================
JWT_SECRET=change-this-to-another-random-string
JWT_EXPIRY=86400

# =====================================================
# PAYMENT GATEWAY (Midtrans/Xendit)
# =====================================================
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# Xendit (alternative)
XENDIT_SECRET_KEY=your-xendit-secret-key

# =====================================================
# EMAIL CONFIGURATION (SMTP)
# =====================================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your-mailtrap-user
MAIL_PASS=your-mailtrap-password
MAIL_FROM=noreply@linkpendek.id
MAIL_FROM_NAME=LinkPendek

# =====================================================
# STORAGE
# =====================================================
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE=5242880

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =====================================================
# LOGGING
# =====================================================
LOG_PATH=./logs
LOG_LEVEL=error
